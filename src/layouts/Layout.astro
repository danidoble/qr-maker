---
import '../styles/global.css';
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>QR Maker — Advanced QR Code Generator</title>
    <meta name="description" content="Create beautifully styled QR codes with custom shapes, colors, logos and frames." />
    <script is:inline>
      // Apply theme before first paint to avoid flash
      (function () {
        const stored = localStorage.getItem('qr-maker-theme');
        const preferred = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', stored || preferred);
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
